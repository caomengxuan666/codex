--- /dev/null
+++ b/scripts/niu/sync-upstream.sh
@@ -0,0 +1,188 @@
+#!/usr/bin/env bash
+# Keep this fork in step with upstream openai/codex.
+#
+# The fork's delta is deliberately small (a shell type, its detection, parsing
+# and safety rules, and the sandbox plumbing). The job of this script is to make
+# that delta visible, reproducible, and provably applied to a current upstream.
+#
+# Subcommands:
+#   pin      record the upstream commit this fork is currently based on
+#   drift    show how far behind upstream main is, and what changed upstream
+#   rebase   fetch upstream and replay the fork's commits on top of it
+#   export   write the delta to patches/niu/ as a mail-formatted series
+#   check    apply the exported patches to a pristine upstream checkout
+#            (git apply -3) and report conflicts without touching this tree
+#
+# Typical loop after an upstream release:
+#   scripts/niu/sync-upstream.sh drift
+#   scripts/niu/sync-upstream.sh rebase
+#   scripts/niu/sync-upstream.sh export
+#   scripts/niu/sync-upstream.sh check
+#   scripts/niu/sync-upstream.sh pin
+#
+# HTTP proxy: on networks where GitHub needs one, configure it once per clone,
+# otherwise every fetch here fails with "remote helper 'https' aborted session":
+#   git config http.proxy http://127.0.0.1:65532
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+cd "$REPO_ROOT"
+
+UPSTREAM_REMOTE="${UPSTREAM_REMOTE:-upstream}"
+UPSTREAM_BRANCH="${UPSTREAM_BRANCH:-main}"
+PATCH_DIR="patches/niu"
+PIN_FILE="patches/UPSTREAM"
+BRANCH="$(git rev-parse --abbrev-ref HEAD)"
+
+die() { printf 'error: %s\n' "$*" >&2; exit 1; }
+
+require_upstream() {
+  git remote get-url "$UPSTREAM_REMOTE" >/dev/null 2>&1 \
+    || die "no '$UPSTREAM_REMOTE' remote; add it with: git remote add upstream https://github.com/openai/codex.git"
+}
+
+# Files where the fork changes behaviour upstream also changes. Conflicts here
+# are expected, and a stale patch here is a safety problem rather than a
+# cosmetic one: upstream keeps adding dangerous-command rules.
+HOT_FILES=(
+  codex-rs/shell-command/src/shell_detect.rs
+  codex-rs/shell-command/src/bash.rs
+  codex-rs/shell-command/src/parse_command.rs
+  codex-rs/shell-command/src/command_safety/is_safe_command.rs
+  codex-rs/shell-command/src/command_safety/is_dangerous_command.rs
+)
+
+cmd_fetch() {
+  require_upstream
+  echo "fetching $UPSTREAM_REMOTE/$UPSTREAM_BRANCH (no tags)"
+  echo "note: the first fetch of this repository is large (hundreds of MB)."
+  echo "      fetch again later and it is incremental."
+  git fetch --no-tags "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH"
+  echo "now at $(git rev-parse --short "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH")"
+}
+
+cmd_drift() {
+  require_upstream
+  # No fetch here on purpose: fetching this repository is a large operation, so
+  # `fetch` is its own step. Compare against whatever upstream ref exists and
+  # say how old it is.
+  local when
+  when="$(git show -s --format=%cI "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH" 2>/dev/null || echo unknown)"
+  echo "upstream $UPSTREAM_REMOTE/$UPSTREAM_BRANCH : $(git rev-parse --short "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH")  (fetched object date: $when)"
+  echo "branch   $BRANCH : $(git rev-parse --short HEAD)"
+  echo "run 'scripts/niu/sync-upstream.sh fetch' first if that looks stale."
+  echo
+  echo "behind / ahead (upstream...HEAD):"
+  git rev-list --left-right --count "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH...HEAD" | \
+    while read -r behind ahead; do echo "  behind $behind, ahead $ahead"; done
+  echo
+  echo "commits upstream gained since the merge base:"
+  # -n instead of `| head`: pipefail would abort the script on SIGPIPE.
+  git log --oneline -n 15 "$(git merge-base HEAD "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH")..$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+  echo
+  echo "upstream commits touching this fork's hot files:"
+  git log --oneline -n 15 "$(git merge-base HEAD "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH")..$UPSTREAM_REMOTE/$UPSTREAM_BRANCH" -- "${HOT_FILES[@]}"
+  echo
+  echo "this fork's delta:"
+  git diff --stat "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH...HEAD" | tail -3
+}
+
+cmd_rebase() {
+  require_upstream
+  echo "fetching $UPSTREAM_REMOTE/$UPSTREAM_BRANCH (no tags; large on the first run)"
+  git fetch --no-tags "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH"
+  echo "replaying $(git rev-list --count "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH..HEAD") commit(s) onto $UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+  git rebase "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+  echo "done. resolve conflicts file by file, then: scripts/niu/sync-upstream.sh export"
+}
+
+cmd_export() {
+  mkdir -p "$PATCH_DIR"
+  rm -f "$PATCH_DIR"/*.patch
+  git format-patch --no-signature --zero-commit \
+    --output-directory "$PATCH_DIR" "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH..HEAD" >/dev/null
+  echo "wrote $(ls "$PATCH_DIR"/*.patch | wc -l) patch(es) to $PATCH_DIR"
+  ls -1 "$PATCH_DIR"
+}
+
+cmd_check() {
+  [ -d "$PATCH_DIR" ] || die "$PATCH_DIR does not exist; run export first"
+  local work
+  work="$(mktemp -d)"
+  echo "pristine upstream checkout in $work"
+  git worktree add --quiet --detach "$work/upstream" "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+  local status=0
+  (
+    cd "$work/upstream"
+    if git apply --check "$REPO_ROOT/$PATCH_DIR"/*.patch 2>"$work/apply.log"; then
+      echo "patches apply exactly to $UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+    elif git apply -3 "$REPO_ROOT/$PATCH_DIR"/*.patch 2>>"$work/apply.log"; then
+      echo "patches needed a three-way merge against $UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+      echo "(same result a rebase would produce; review the diff below)"
+    else
+      echo "PATCH CONFLICT against $UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+      status=1
+      # --3way left the tree untouched (apply is atomic). Re-run with --reject so
+      # the hunks that do fit land and the failures are enumerated per file.
+      # --reject cannot be combined with --3way, so this is context-only.
+      git apply --reject "$REPO_ROOT/$PATCH_DIR"/*.patch >>"$work/apply.log" 2>&1 || true
+      local rejected
+      rejected="$(find . -name '*.rej' -not -path './.git/*' | sed 's|^\./||' | sort)"
+      if [ -n "$rejected" ]; then
+        echo
+        echo "hunks that no longer apply (each needs a manual rebase):"
+        printf '  %s\n' $rejected
+      fi
+    fi
+    # Files the patch touches that upstream moved or removed. These need the
+    # patch re-targeted, not a merge conflict resolved.
+    if grep -E 'No such file or directory|does not exist in index' "$work/apply.log" >/dev/null 2>&1; then
+      echo
+      echo "targets that no longer exist upstream:"
+      grep -E 'No such file or directory|does not exist in index' "$work/apply.log" | sed 's/^/  /'
+    fi
+    local conflicted
+    conflicted="$(git ls-files -u | cut -f2 | sort -u)"
+    if [ -n "$conflicted" ]; then
+      echo
+      echo "conflicted files (a rebase would stop on these):"
+      printf '  %s\n' $conflicted
+    fi
+    echo
+    echo "fork delta as far as it applied:"
+    git diff --stat | tail -5
+    exit $status
+  ) || status=$?
+  git worktree remove --force "$work/upstream" 2>/dev/null || true
+  rm -rf "$work"
+  return $status
+}
+
+cmd_pin() {
+  require_upstream
+  mkdir -p "$(dirname "$PIN_FILE")"
+  local base
+  base="$(git merge-base HEAD "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH")"
+  {
+    echo "# Upstream commit this fork is based on."
+    echo "# Refreshed by scripts/niu/sync-upstream.sh pin after every rebase."
+    echo "repo=https://github.com/openai/codex"
+    echo "branch=$UPSTREAM_BRANCH"
+    echo "commit=$base"
+    echo "commit_date=$(git show -s --format=%cI "$base")"
+    echo "fork_commits=$(git rev-list --count "$base..HEAD")"
+  } > "$PIN_FILE"
+  cat "$PIN_FILE"
+}
+
+case "${1:-}" in
+  pin)    cmd_pin ;;
+  fetch)  cmd_fetch ;;
+  drift)  cmd_drift ;;
+  rebase) cmd_rebase ;;
+  export) cmd_export ;;
+  check)  cmd_check ;;
+  *) sed -n '2,34p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
+esac
diff --git a/scripts/niu/verify-npm-package.sh b/scripts/niu/verify-npm-package.sh
new file mode 100644
index 0000000000..361c5f5f16
--- /dev/null
+++ b/scripts/niu/verify-npm-package.sh
@@ -0,0 +1,162 @@
+#!/usr/bin/env bash
+# Stage, pack, and install-test the @cmx666/codex npm packages.
+#
+# Verifies the thing that actually breaks in practice: a tarball that installs
+# but is missing a binary, a resource, or the launcher's vendor tree.
+#
+# Usage:
+#   scripts/niu/verify-npm-package.sh <version> [vendor-root] [work-dir]
+#
+#   version     npm release version, e.g. 0.163.0-alpha.1
+#   vendor-root directory whose child is the target triple, containing the
+#               canonical package layout (bin/, codex-resources/, codex-path/,
+#               codex-package.json). Build it with:
+#                 python scripts/build_codex_package.py --target x86_64-pc-windows-msvc \
+#                   --variant codex --cargo-profile release \
+#                   --package-dir <vendor-root>/x86_64-pc-windows-msvc --force
+#   work-dir    scratch directory (default: a temp dir)
+#
+# Windows note: the meta package only ships bin/codex.js, so the launcher finds
+# binaries through optionalDependencies or, absent that, its vendored sibling
+# tree. Staging with --vendor-src gives it that tree, which is what makes the
+# local install test meaningful before anything is published.
+
+set -euo pipefail
+
+VERSION="${1:?usage: verify-npm-package.sh <version> [vendor-root] [work-dir]}"
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+VENDOR_ROOT="${2:-$(mktemp -d)/vendor}"
+WORK_DIR="${3:-$(mktemp -d)}"
+TRIPLE="x86_64-pc-windows-msvc"
+PLATFORM_TAG="win32-x64"
+
+step() { printf '\n=== %s\n' "$1"; }
+
+step "inputs"
+echo "repo        : $REPO_ROOT"
+echo "version     : $VERSION"
+echo "vendor root : $VENDOR_ROOT"
+echo "work dir    : $WORK_DIR"
+echo "platform    : $TRIPLE ($PLATFORM_TAG)"
+
+step "1/6 canonical package layout is complete"
+PKG="$VENDOR_ROOT/$TRIPLE"
+REQUIRED="
+bin/codex.exe
+bin/codex-code-mode-host.exe
+codex-resources/codex-command-runner.exe
+codex-resources/codex-windows-sandbox-setup.exe
+codex-path/rg.exe
+codex-package.json
+"
+missing=0
+for rel in $REQUIRED; do
+  if [ -f "$PKG/$rel" ]; then
+    printf '  ok      %-46s %s bytes\n' "$rel" "$(stat -c '%s' "$PKG/$rel")"
+  else
+    printf '  MISSING %s\n' "$rel"
+    missing=1
+  fi
+done
+[ "$missing" -eq 0 ] || { echo "layout incomplete; refusing to stage"; exit 1; }
+echo "  codex-package.json:"
+cat "$PKG/codex-package.json"
+
+step "2/6 stage the meta package (bin/codex.js + vendor tree)"
+STAGE_META="$WORK_DIR/meta"
+rm -rf "$STAGE_META"; mkdir -p "$STAGE_META"
+python "$REPO_ROOT/codex-cli/scripts/build_npm_package.py" \
+  --package codex \
+  --vendor-src "$VENDOR_ROOT" \
+  --release-version "$VERSION" \
+  --staging-dir "$STAGE_META"
+
+step "3/6 stage the platform package"
+STAGE_PLATFORM="$WORK_DIR/platform"
+rm -rf "$STAGE_PLATFORM"; mkdir -p "$STAGE_PLATFORM"
+python "$REPO_ROOT/codex-cli/scripts/build_npm_package.py" \
+  --package "codex-$PLATFORM_TAG" \
+  --vendor-src "$VENDOR_ROOT" \
+  --release-version "$VERSION" \
+  --staging-dir "$STAGE_PLATFORM"
+
+step "4/6 pack both packages and report what npm will ship"
+(cd "$STAGE_META" && npm pack --json >/dev/null && cp ./*.tgz "$WORK_DIR/")
+(cd "$STAGE_PLATFORM" && npm pack --json >/dev/null && cp ./*.tgz "$WORK_DIR/")
+python - "$WORK_DIR" <<'PY'
+import glob, os, sys, tarfile
+work = sys.argv[1]
+for tgz in sorted(glob.glob(os.path.join(work, "*.tgz"))):
+    with tarfile.open(tgz) as tf:
+        members = [m for m in tf.getmembers() if m.isfile()]
+        total = sum(m.size for m in members)
+    print(f"  {os.path.basename(tgz)}: {len(members)} files, {total/1_000_000:.1f} MB unpacked, "
+          f"{os.path.getsize(tgz)/1_000_000:.1f} MB on the wire")
+    for m in members[:8]:
+        print(f"      {m.name}  {m.size}")
+    if len(members) > 8:
+        print(f"      ... {len(members)-8} more")
+PY
+
+step "5/6 install the meta package and simulate the npm alias optional dependency"
+# The meta package ships only bin/codex.js: its binaries arrive through
+# optionalDependencies as `npm:@cmx666/codex@<version>-win32-x64`, which npm
+# installs under the alias path node_modules/@cmx666/codex-win32-x64/. Nothing
+# is published yet, so unpack the platform tarball to that exact path. This is
+# the same resolution the launcher performs in a real install.
+PROJ="$WORK_DIR/proj"
+rm -rf "$PROJ"; mkdir -p "$PROJ"
+(cd "$PROJ" && npm init -y >/dev/null 2>&1)
+META_TGZ="$(ls "$WORK_DIR"/cmx666-codex-*.tgz | grep -v "$PLATFORM_TAG" | head -1)"
+PLATFORM_TGZ="$(ls "$WORK_DIR"/cmx666-codex-*-"$PLATFORM_TAG".tgz | head -1)"
+[ -n "$META_TGZ" ] && [ -n "$PLATFORM_TGZ" ] || { echo "missing a tarball"; exit 1; }
+(cd "$PROJ" && npm install --omit=optional --no-audit --no-fund "$META_TGZ")
+ALIAS_DIR="$PROJ/node_modules/@cmx666/codex-$PLATFORM_TAG"
+# Unpack with Python's tarfile, not tar. On Windows the runner's temp dir is a
+# native `D:\a\_temp` path, and tar reads the drive colon as a remote host
+# ("Cannot connect to D:"). --force-local and cygpath normalization both still
+# trip over the mixed separators Git Bash produces from `$RUNNER_TEMP/...`.
+# tarfile takes the path natively and is already a dependency of this script.
+rm -rf "$ALIAS_DIR"
+python - "$PLATFORM_TGZ" "$ALIAS_DIR" <<'PY'
+import os
+import shutil
+import sys
+import tarfile
+
+tgz, dest = sys.argv[1], sys.argv[2]
+os.makedirs(dest, exist_ok=True)
+with tarfile.open(tgz) as archive:
+    for member in archive.getmembers():
+        # npm tarballs are rooted at `package/`; the tar call this replaces
+        # used --strip-components=1 to drop that level.
+        if not member.name.startswith("package/"):
+            continue
+        relative = member.name[len("package/"):]
+        if not relative:
+            continue
+        target = os.path.join(dest, *relative.split("/"))
+        if member.isdir():
+            os.makedirs(target, exist_ok=True)
+        elif member.isfile():
+            os.makedirs(os.path.dirname(target), exist_ok=True)
+            with archive.extractfile(member) as source, open(target, "wb") as output:
+                shutil.copyfileobj(source, output)
+        else:
+            print(f"  skipping non-file member: {member.name}")
+PY
+echo "  meta package   : $PROJ/node_modules/@cmx666/codex"
+echo "  platform alias : $ALIAS_DIR ($(find "$ALIAS_DIR" -type f | wc -l) files)"
+echo "  resolved by the launcher:"
+node -e "console.log('    ' + require.resolve('@cmx666/codex-$PLATFORM_TAG/package.json'))" --prefix "$PROJ" 2>/dev/null \
+  || (cd "$PROJ" && node -e "console.log('    ' + require.resolve('@cmx666/codex-$PLATFORM_TAG/package.json'))")
+(cd "$PROJ" && ./node_modules/.bin/codex --version)
+(cd "$PROJ" && ./node_modules/.bin/codex --help 2>&1 | head -3)
+
+step "6/6 publish order reminder"
+printf '  Publish the platform package first, then the meta package:\n'
+printf '    npm publish %s --tag %s\n' "$(basename "$PLATFORM_TGZ")" "$PLATFORM_TAG"
+printf '    npm publish %s --tag latest\n' "$(basename "$META_TGZ")"
+
+printf '\nAll checks passed for %s\n' "$VERSION"
